SECRET_KEY=django-insecure-saec-cafe-c++-cafe-secret-key-2026-production-ready-key
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# ==============================================================================
# OPTION 1: Railway Production Database (Automatically provided by Railway)
# ==============================================================================
# DATABASE_URL=postgresql://postgres:<password>@<host>:<port>/railway

# ==============================================================================
# OPTION 2: Local PostgreSQL Development
# ==============================================================================
USE_POSTGRES=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=saec_cafe
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

