# Security
SECRET_KEY=your_generated_secret_key_here
DEBUG=False
ALLOWED_HOSTS=web-production-85e59.up.railway.app,localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ==============================================================================
# PRODUCTION DATABASE (PostgreSQL / Railway)
# Provided automatically by Railway PostgreSQL or configured manually
# ==============================================================================
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway

# ==============================================================================
# LOCAL POSTGRESQL DEVELOPMENT (Alternative)
# ==============================================================================
# USE_POSTGRES=True
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=saec_cafe
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ==============================================================================
# CORS & CSRF TRUSTED ORIGINS
# Comma-separated list of allowed frontend URLs (e.g. Vercel, Localhost)
# ==============================================================================
CORS_ALLOWED_ORIGINS=https://cafe-management-frontend-kappa.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://cafe-management-frontend-kappa.vercel.app,https://web-production-85e59.up.railway.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

